# Database Configuration (SQLite default for local dev/testing, PostgreSQL for production)
DATABASE_URL=sqlite:///./escalations.db

# Organizer Admin Authentication Token / API Key
ADMIN_API_KEY=dev-organizer-secret-key-change-in-production

# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=organizer@example.com
SMTP_PASSWORD=change-me-to-app-password
SMTP_FROM_EMAIL=no-reply@aws-sbg-kiit.org
ORGANIZER_EMAIL=organizer-alert@aws-sbg-kiit.org
SMTP_USE_TLS=true

# Abuse / Spam Protection (per-IP rate limit on POST /v1/escalations)
RATE_LIMIT_PER_MINUTE=5

# CORS Allowed Origins (for frontend dashboard)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
