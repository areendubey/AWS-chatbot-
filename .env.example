# ==========================================
# Application Configuration
# ==========================================
APP_ENV=development
APP_VERSION=1.0.0
LOG_LEVEL=INFO
API_PREFIX=/v1
CHAT_MAX_INPUT_CHARS=1000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ==========================================
# Google Gemini LLM Provider (Primary & Only LLM)
# ==========================================
# Developer key for local development. Never commit real keys.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
LLM_TIMEOUT_SECONDS=15
LLM_MAX_RETRIES=2

# ==========================================
# Databases & Vector Store
# ==========================================
# SQLite for local development/testing; PostgreSQL for production
DATABASE_URL=sqlite:///./society_chatbot.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/society_chatbot

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=society_events_v1
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Optional Redis for distributed rate limits & session state across replicas
# REDIS_URL=redis://localhost:6379/0

# ==========================================
# Authentication & Identity (Google Sign-In)
# ==========================================
GOOGLE_CLIENT_ID=your_google_client_id_here
ADMIN_SECRET_KEY=dev-organizer-secret-key-change-in-production
SERVICE_API_KEY=dev-service-api-key-change-in-production

# ==========================================
# Organizer Alerts & Escalation SMTP
# ==========================================
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@aws-sbg-kiit.org
ORGANIZER_EMAIL=organizer-alert@aws-sbg-kiit.org
SMTP_USE_TLS=true
